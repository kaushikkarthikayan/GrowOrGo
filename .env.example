# Copy this file to ".env" and fill in your values. Never upload .env to GitHub.

# ---- AI provider ----
# auto = use whichever key below is filled in; demo = no AI (rule-based only)
LLM_PROVIDER=auto

# Fill in ONE of these
GEMINI_API_KEY=
# Leave empty to auto-pick a free model that works
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Jobs (Adzuna: https://developer.adzuna.com/) ----
# Leave empty to use the built-in demo listings
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Stop using Adzuna after this many live calls (trial keys allow 25 in total). Raise it if you upgrade.
ADZUNA_MAX_CALLS=20

# Meaning-based matching model (downloads ~90 MB once). Set to false to use simple word matching.
USE_EMBEDDINGS=true

# Path to Tesseract OCR (Windows default). Leave as is if you installed to the default folder.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: GitHub token for reading portfolio repos (higher rate limit)
GITHUB_TOKEN=

# Largest upload allowed, in MB
MAX_FILE_MB=10
